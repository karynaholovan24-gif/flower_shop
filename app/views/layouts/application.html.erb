
<!DOCTYPE html>
<html>
<head>
  <title>Flower Shop</title>
  <meta name="viewport" content="width=device-width,initial-scale=1">

  <%= csrf_meta_tags %>
  <%= csp_meta_tag %>

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
        rel="stylesheet">
</head>

<body class="bg-light">

  <!-- HEADER -->
  <header class="bg-success text-white p-3">
    <div class="container d-flex justify-content-between align-items-center">
      <h2>🌸 Flower Shop</h2>

      <div>
        <strong>Експрес-доставка:</strong>
        <span id="delivery-timer">30:00</span>
      </div>
    </div>
  </header>

  <!-- NAVIGATION -->
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
    <div class="container">

      <a class="navbar-brand" href="/">Головна</a>

      <div class="navbar-nav">

        <%= link_to "Про проєкт",
            about_path, class: "nav-link" %>

        <%= link_to "Створити квітку",
            new_flower_path, class: "nav-link" %>

        <%= link_to "Показати всі квіти",
            flowers_path, class: "nav-link" %>

        <%= button_to "Видалити всі квіти",
            destroy_all_flowers_path,
            method: :delete,
            class: "btn btn-danger ms-2",
            form: { data: {
              turbo_confirm: "Ви впевнені, що хочете видалити всі квіти?"
            } } %>

      </div>
    </div>
  </nav>

  <!-- MAIN CONTENT -->
  <main class="container my-4">
    <% if notice %>
      <div class="alert alert-success">
        <%= notice %>
      </div>
    <% end %>

    <%= yield %>
  </main>

  <!-- FOOTER -->
  <footer class="bg-dark text-white p-4 mt-5">
    <div class="container">
      <h4>Поради щодо догляду за квітами 🌷</h4>

      <ul>
        <li>Регулярно змінюйте воду у вазі.</li>
        <li>Обрізайте кінчики стебел.</li>
        <li>Не залишайте букети під прямими сонячними променями.</li>
        <li>Тримайте квіти подалі від джерел тепла.</li>
      </ul>

      <hr>

      <p>Контакти розробника: karyna.holovan.24@pnu.edu.ua</p>
      <p class="mb-0">
        © 2026 Flower Shop. Усі права захищені.
      </p>
    </div>
  </footer>

  <script>
    let seconds = 30 * 60;

    setInterval(function() {
      if (seconds > 0) {
        seconds--;

        let minutes = Math.floor(seconds / 60);
        let remaining = seconds % 60;

        document.getElementById("delivery-timer").textContent =
          String(minutes).padStart(2, "0") + ":" +
          String(remaining).padStart(2, "0");
      }
    }, 1000);
  </script>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

</body>
</html>
